{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "turso": {
                "type": "local",
                "command": ["tursodb", "--mcp"],
                "disabled": false
            },
            "aws-mcp": {
                "type": "local",
                "command": [
                    "uvx",
                    "mcp-proxy-for-aws@latest",
                    "https://aws-mcp.us-east-1.api.aws/mcp",
                    "--metadata",
                    "AWS_REGION=ap-southeast-1"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 100000,
                    "execution": 100000
                }
            },
            "next-devtools": {
                "type": "local",
                "command": ["npx", "-y", "next-devtools-mcp@latest"]
            },
            "terraform": {
                "type": "local",
                "command": ["terraform-mcp-server"]
            }
        }
    }
}
